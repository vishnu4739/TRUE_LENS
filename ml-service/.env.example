# TrueLens ML Service Configuration
# =================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model Configuration
MODEL_DIR=models/saved
RESULTS_DIR=results
DATA_DIR=data

# Image Preprocessing
IMAGE_SIZE_DEEP=224
IMAGE_SIZE_TRADITIONAL=128
BATCH_SIZE=32

# Training
RANDOM_SEED=42
EPOCHS_CNN=20
EPOCHS_VIT=20
LEARNING_RATE=0.001
TRAIN_SPLIT=0.8
VAL_SPLIT=0.1
TEST_SPLIT=0.1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Logging
LOG_LEVEL=INFO
